# ==============================================================================
# OLIST STRATEGIC ANALYTICS & DIAGNOSTICS - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Sao chép file này thành .env và điền thông tin thực tế của bạn:

# --- MySQL Database Configuration ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=olist_raw

# (Tùy chọn nếu dùng Aiven Cloud MySQL)
# DB_HOST=mysql-xxxxxx.aivencloud.com
# DB_PORT=18064
# DB_USER=avnadmin
# DB_PASSWORD=your_aiven_password
# DB_NAME=defaultdb

# --- Email Reporting Configuration (Gmail App Password) ---
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password
EMAIL_TO=recipient@example.com

# --- AI Integration (Optional) ---
GEMINI_API_KEY=your_gemini_api_key_here
